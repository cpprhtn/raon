# Copy this file to .env and fill in your tokens. .env is gitignored — never commit it.
# Create tokens at https://pypi.org/manage/account/token/ (scope to the "raon" project).

# Required for: scripts/publish.sh
PYPI_TOKEN=pypi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Required for: scripts/publish.sh --test
TESTPYPI_TOKEN=pypi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: used by the LLM provider (raon.llm.anthropic_provider)
# ANTHROPIC_API_KEY=sk-ant-...
